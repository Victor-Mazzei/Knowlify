KNOWLIFY_USER=admin
# Change this before the first start. The server warns at startup when it keeps one of the
# seeded values and listens beyond loopback.
KNOWLIFY_PASSWORD=change-this-password
# Host folder with your ebooks (for example, an SMB mount). Mounted read-only at /library.
KNOWLIFY_LIBRARY_DIR=/mnt/ebooks
# Roots that GET /api/fs can browse and POST /api/sources can register, separated by commas.
# Default: KNOWLIFY_LIBRARY_PATHS (in Docker, /library). `any` allows the whole filesystem (local use).
# Registered sources are still scanned even outside the roots.
# KNOWLIFY_BROWSE_ROOTS=/library
# Port published on the host.
KNOWLIFY_PORT=8787
# Trust X-Forwarded-For only behind a reverse proxy you control.
# off (default) uses the socket address. on trusts every proxy; a number trusts that many hops
# from the socket; a comma-separated list trusts only those proxy IPs/CIDRs (recommended).
# Never enable this when clients can reach the server directly: they can forge the header and
# bypass per-IP limits (MCP failures and password changes).
# KNOWLIFY_TRUST_PROXY=off
# Server log level: error | warn | info | debug | trace | silent. Default: info.
# debug/trace add outbound HTTP (metadata, covers, LLM, RSS, model probes), SSRF destination
# decisions, auth failures, MCP tool/scope and indexing/scanner events. No level ever logs
# API keys, passwords, tokens, secrets, chat prompts, passages, notes, book text, ISBN/title/
# author searches or URLs with a query string (request lines are reduced to the path).
# KNOWLIFY_LOG_LEVEL=info

# --- Image build information (set by the build, not by the operator) ---
# The image build passes GIT_SHA/BUILD_DATE as --build-arg. The Dockerfile writes
# KNOWLIFY_BUILD_COMMIT/KNOWLIFY_BUILD_DATE to the final environment. GET /api/about reads
# these values from the image. Do not set them in the container environment in production.
# For a local build with docker compose, uncomment the two lines below before
# `docker compose build` (CI does this automatically).
# KNOWLIFY_BUILD_COMMIT=abc1234
# KNOWLIFY_BUILD_DATE=2026-11-07T12:00:00Z
# Repository URL published by GET /api/about (optional). It must be an http(s) URL.
# The image build passes it as --build-arg SOURCE_URL; docker compose reads KNOWLIFY_SOURCE_URL.
# KNOWLIFY_SOURCE_URL=https://github.com/example-org/knowlify
# Used only in the OCI label for local builds; the app version comes from the package.json files.
# KNOWLIFY_VERSION=1.0.0

# Forgot the password changed in the UI? Uncomment this line, restart, and sign in with KNOWLIFY_PASSWORD above.
# KNOWLIFY_FORCE_ENV_PASSWORD=1

# --- Folder scanning and metadata extraction ---
# Seconds between automatic folder scans. Default: 600. 0 disables them (only POST /api/scan).
# KNOWLIFY_SCAN_INTERVAL=600
# Parallel stat calls while walking a source. Default: 8.
# KNOWLIFY_SCAN_CONCURRENCY=8
# Metadata extraction workers (PDF/EPUB). Default: min(3, CPUs-1), at least 1.
# KNOWLIFY_METADATA_WORKERS=3

# --- Book search index (Knowledge context) ---
# on|off. When off, the app still works and the /api/index and /api/passages routes return 409/503.
KNOWLIFY_INDEXING=on
# Concurrent jobs per worker. Total concurrency is the pool size (KNOWLIFY_INDEX_WORKERS).
KNOWLIFY_INDEX_CONCURRENCY=1
# Books larger than this are not indexed (the file stays in the library).
KNOWLIFY_INDEX_MAX_MB=200
# Backfill of existing books at startup: auto|on|off.
# auto enables it with embeddings none/local and disables it with http (this avoids sending the library to a provider). Use on to allow it.
KNOWLIFY_INDEX_BACKFILL=auto
# Ingestion workers (extraction + embeddings). Default: min(3, CPUs-1), at least 1.
# The wiring uses 1 with local embeddings (onnxruntime already uses KNOWLIFY_EMBEDDINGS_THREADS) and 2 with http.
# KNOWLIFY_INDEX_WORKERS=2
# Books that receive vectors automatically. 0 disables the automatic mode: vectors only on demand
# (open the book or index selected books). Default: 1000.
# KNOWLIFY_INDEX_VECTORS_MAX_BOOKS=1000
# Above this vector count, vector search without bookId uses a lexical prefilter.
# Default: 300000.
# KNOWLIFY_VECTOR_SCAN_MAX=300000
# Embeddings provider: none (lexical search only) | local (ONNX, ~120 MB on first use) | http (OpenAI-compatible API).
KNOWLIFY_EMBEDDINGS=local
# onnxruntime threads in the indexing worker. Default: min(4, available CPUs).
# Set explicitly to avoid the pthread_setaffinity_np warning in containers with a cpuset.
# KNOWLIFY_EMBEDDINGS_THREADS=4
# Used by local (default Xenova/multilingual-e5-small) and by http (model id at the provider).
# KNOWLIFY_EMBEDDINGS_MODEL=Xenova/multilingual-e5-small
# For http only. Example: Ollama at http://127.0.0.1:11434/v1 or OpenAI at https://api.openai.com/v1.
# Private IPs are allowed here on purpose: the URL belongs to the operator, not the end user.
# Book excerpts leave the machine when http is active.
# KNOWLIFY_EMBEDDINGS_URL=http://127.0.0.1:11434/v1
# Never appears in logs or in /api/index/status.
# KNOWLIFY_EMBEDDINGS_API_KEY=
# 1 blocks network access in the local provider. Use it with the model already copied to KNOWLIFY_MODELS_DIR.
# KNOWLIFY_EMBEDDINGS_OFFLINE=1
# Model cache. Default: $KNOWLIFY_DATA/models.
# KNOWLIFY_MODELS_DIR=./data/models

# --- Tutor chat (optional LLM, Assistant context) ---
# Without URL, key and model, the chat stays off and hidden in the UI (/api/chat/status enabled:false).
# Provider URL. Use the base URL or the full endpoint of the selected API style; the server
# does not add the suffix twice. Examples: https://api.example.com/v1 (openai) and
# https://api.example.com (anthropic, the server appends /v1/messages).
# You can also use a local server, for example http://localhost:11434/v1.
# Private IPs are allowed here on purpose: the operator owns this URL, not the end user (ADR-12).
# The full URL, the key and the custom header values never appear in logs or /api/chat/status
# (only the hostname).
# API style of the language model provider: openai (default) or anthropic.
# openai: chat completions API. The API key is sent as "Authorization: Bearer".
# anthropic: Messages API. The API key is sent as "x-api-key" and "anthropic-version" defaults
# to 2023-06-01 (override it with a custom header).
# KNOWLIFY_LLM_API_STYLE=openai
# KNOWLIFY_LLM_URL=https://api.example.com/v1
# KNOWLIFY_LLM_API_KEY=
# Custom HTTP headers for the provider (optional). One JSON object.
# Example: {"x-session-id":"{{conversationId}}"}
# {{conversationId}} is replaced by the ID of the current conversation. At most 8 headers;
# names are RFC 7230 tokens and values are visible ASCII (up to 512 characters).
# Header values are secrets: they are encrypted when saved in Settings and never shown again.
# Authorization, Host, Content-Type, Cookie and similar headers are not allowed.
# This variable applies only to the environment configuration; Settings replaces it as a block.
# Leave it unset to use the legacy session header until 2.0; an empty value or {} disables it.
# KNOWLIFY_LLM_HEADERS={}
# Exact model id at the provider. Example: your-model-id.
# KNOWLIFY_LLM_MODEL=your-model-id
# Response token cap and total stream timeout, in seconds.
# KNOWLIFY_LLM_MAX_TOKENS=1024
# KNOWLIFY_LLM_TIMEOUT_SEC=120
# Messages per minute, with at most 2 concurrent streams.
# KNOWLIFY_LLM_RATE_PER_MIN=20
#
# --- LLM configured in the UI (Settings) ---
# A saved Settings configuration replaces the whole block above; DELETE
# /api/settings/llm goes back to the environment. The key is encrypted (AES-256-GCM).
# 1 locks the configuration to the environment: PUT/DELETE and draft probes return 403.
# Only the Test of the effective configuration still works.
# KNOWLIFY_LLM_LOCKED=1
# Destinations for the URL saved in the UI:
#   off      public addresses only, with HTTPS on port 443 required (default);
#   on       allows loopback and private networks (never link-local/metadata);
#   list     comma-separated CIDRs (example: 127.0.0.1/32,192.168.1.0/24).
# In the local desktop app, the app sets "on" when it starts Node. In Docker, use on or the
# bridge CIDR to reach an Ollama server running on the host.
# KNOWLIFY_LLM_ALLOW_PRIVATE=off
# Server secret used to encrypt the LLM key (at least 32 characters). Without it, the
# server creates data/secret.key with mode 0600 when it saves the first key. Keep the
# secret outside the data/ folder to separate the vault from the database.
# KNOWLIFY_SECRET=

# --- External metadata (Open Library, with Google Books as fallback) ---
# The lookup runs only on an explicit user action (title/author/ISBN go to the
# providers). on|off (default: on). off also disables cover-by-URL (403 lookup_disabled)
# and keeps manual metadata editing working.
# KNOWLIFY_METADATA_LOOKUP=on
# Optional Google Books key (fallback) as the environment seed; a key saved in Settings
# overrides it. It increases the quota; it never appears in a log, error, or response.
# Without a key, the shared quota can return 429.
# KNOWLIFY_GOOGLE_BOOKS_API_KEY=
# 1 locks the lookup toggle and the Google Books key to the environment: PUT
# /api/settings/metadata returns 403 metadata_locked and a saved key is ignored.
# The key can also be saved in Settings (encrypted with AES-256-GCM, like the LLM key);
# a saved value overrides the environment one.
# KNOWLIFY_METADATA_LOCKED=1

# --- MCP (Model Context Protocol) ---
# POST /mcp endpoint authenticated with Bearer (tokens created in Settings → MCP access).
# When off, the route does not exist (404) and POST /api/mcp/tokens returns 404 mcp_disabled.
# KNOWLIFY_MCP=on
# JSON-RPC messages per minute, per token (default 120). Each item in a batch counts.
# KNOWLIFY_MCP_RATE_PER_MIN=120
# Writes (create_note/add_tags/remove_tags/set_book_favorite) per minute, per token, counted per item (default 20).
# KNOWLIFY_MCP_WRITE_RATE_PER_MIN=20
# Full origins allowed for requests with an Origin header, separated by
# commas (example: https://claude.ai,http://localhost:5173). Empty = no browser
# origin is accepted. Native clients (without Origin) still work.
# KNOWLIFY_MCP_ALLOWED_ORIGINS=
# Allowed hosts, comma-separated, without a port (example: knowlify.example.com,localhost).
# Blank: with a loopback HOST (desktop), localhost,127.0.0.1,[::1] are allowed. Behind a proxy
# (HOST=0.0.0.0), the check is off and the required Bearer is the protection.
# KNOWLIFY_MCP_ALLOWED_HOSTS=
# Do not put Traefik basic auth in front of /mcp: it conflicts with the Bearer Authorization header.
